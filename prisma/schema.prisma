generator client {
  provider                    = "prisma-client-py"
  enable_experimental_decimal = true
  recursive_type_depth        = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model address {
  id        String       @id @db.Uuid
  value     String?      @db.VarChar(500)
  type      AddressType?
  createdAt DateTime     @default(now()) @db.Timestamp(6)
  updatedAt DateTime     @db.Timestamp(6)
  isPrimary Boolean      @default(false)
  personId  String?      @db.Uuid
  companyId String?      @db.Uuid
  company   company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people    people?      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([companyId, isPrimary])
  @@index([personId, isPrimary])
  @@index([type])
  @@index([value])
}

model aiAnalytics {
  id                  String    @id @db.Uuid
  workspaceId         String    @db.Uuid
  userId              String?   @db.Uuid
  date                DateTime  @db.Date
  totalQueries        Int       @default(0)
  successfulQueries   Int       @default(0)
  failedQueries       Int       @default(0)
  totalTokens         Int       @default(0)
  totalCost           Decimal   @default(0) @db.Decimal(10, 4)
  averageResponseTime Int?
  functionCalls       Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamp(6)
  updatedAt           DateTime  @db.Timestamp(6)
  user                user?     @relation(fields: [userId], references: [id])
  workspace           workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, date])
  @@index([date])
  @@index([userId, date])
  @@index([workspaceId, date])
}

model aiCache {
  id          String    @id @db.Uuid
  workspaceId String    @db.Uuid
  cacheKey    String
  cacheValue  Json
  expiresAt   DateTime  @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  workspace   workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, cacheKey])
  @@index([cacheKey])
  @@index([expiresAt])
  @@index([workspaceId])
}

model aiFunctionCall {
  id            String             @id @db.Uuid
  interactionId String             @db.Uuid
  functionName  String
  parameters    Json
  status        FunctionCallStatus @default(PENDING)
  result        Json?
  errorMessage  String?
  executionTime Int?
  createdAt     DateTime           @default(now()) @db.Timestamp(6)
  updatedAt     DateTime           @db.Timestamp(6)
  aiInteraction aiInteraction      @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([functionName, status])
  @@index([interactionId])
  @@index([status, createdAt])
}

model aiInteraction {
  id             String              @id @db.Uuid
  workspaceId    String              @db.Uuid
  userId         String              @db.Uuid
  conversationId String?             @db.Uuid
  provider       AIProvider
  status         AIInteractionStatus @default(PENDING)
  userQuery      String
  aiResponse     String?
  errorMessage   String?
  tokensUsed     Int?
  cost           Decimal?            @db.Decimal(10, 4)
  responseTime   Int?
  functionCalls  Json?
  metadata       Json?
  createdAt      DateTime            @default(now()) @db.Timestamp(6)
  updatedAt      DateTime            @db.Timestamp(6)
  aiFunctionCall aiFunctionCall[]
  conversation   conversation?       @relation(fields: [conversationId], references: [id])
  user           user                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([provider, status])
  @@index([status, createdAt])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model column {
  id                        String                      @id @db.Uuid
  groupId                   String                      @db.Uuid
  name                      String
  description               String?
  dataType                  ColumnDataType
  isDefault                 Boolean                     @default(false)
  type                      ColumnType
  isDeleted                 Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  selectOptions             Json?                       @db.Json
  dealId                    String?                     @db.Uuid
  group                     group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  columnValueSelectOption   columnValueSelectOption[]
  columnViewSettings        columnViewSettings[]
  column_values             column_values[]
  deal                      deal[]
  profileColumnViewSettings profileColumnViewSettings[]
  selectOption              selectOption[]
  selectOptionSetting       selectOptionSetting[]
  view                      view[]

  @@unique([groupId, name, type, isDeleted, dealId])
  @@index([dataType, type])
  @@index([groupId, isDefault, isDeleted])
  @@index([groupId, type, isDeleted])
  @@index([name])
}

model columnValueSelectOption {
  id             String       @id @db.Uuid
  selectOptionId String       @db.Uuid
  createdAt      DateTime     @default(now())
  columnId       String       @db.Uuid
  companyId      String?      @db.Uuid
  peopleId       String?      @db.Uuid
  dealId         String?      @db.Uuid
  column         column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  company        company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  people         people?      @relation(fields: [peopleId], references: [id], onDelete: Cascade)
  selectOption   selectOption @relation(fields: [selectOptionId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@index([columnId, selectOptionId, companyId])
  @@index([columnId, selectOptionId])
  @@index([columnId, selectOptionId, peopleId])
  @@index([companyId, columnId])
  @@index([companyId])
  @@index([dealId])
  @@index([peopleId, columnId])
  @@index([peopleId])
  @@index([selectOptionId, companyId])
  @@index([selectOptionId, peopleId])
}

model columnViewSettings {
  id              String         @id @db.Uuid
  order           Int
  isVisible       Boolean        @default(true)
  width           Int?
  columnId        String?        @db.Uuid
  viewId          String         @db.Uuid
  defaultColumnId String?        @db.Uuid
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  column          column?        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  defaultColumn   defaultColumn? @relation(fields: [defaultColumnId], references: [id], onDelete: Cascade)
  view            view           @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([viewId, columnId])
  @@unique([viewId, defaultColumnId])
  @@index([viewId, isDeleted])
  @@index([viewId, order, isVisible])
}

model column_values {
  id              String   @id
  value           String
  createdAt       DateTime @default(now())
  columnId        String   @db.Uuid
  selectedOptions Json?    @db.Json
  companyId       String?  @db.Uuid
  peopleId        String?  @db.Uuid
  dealId          String?  @db.Uuid
  column          column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  company         company? @relation(fields: [companyId], references: [id])
  deal            deal?    @relation(fields: [dealId], references: [id])
  people          people?  @relation(fields: [peopleId], references: [id])

  @@index([columnId, createdAt(sort: Desc)])
  @@index([columnId])
  @@index([columnId, value])
  @@index([companyId, columnId])
  @@index([companyId, columnId, value])
  @@index([companyId])
  @@index([dealId, columnId, value])
  @@index([dealId])
  @@index([peopleId, columnId])
  @@index([peopleId, columnId, value])
  @@index([peopleId])
  @@index([value])
}

model company {
  id                      String                    @id @db.Uuid
  name                    String                    @db.VarChar(100)
  description             String?
  imageUrl                String?
  createdAt               DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                  @db.Timestamp(6)
  privacyLevel            PrivacyLevel?             @default(PRIVATE)
  workspaceId             String                    @db.Uuid
  createdBy               String                    @db.Uuid
  avatarKey               String?
  avatarContentType       String?
  avatarSize              Int?
  avatarEtag              String?
  avatarUpdatedAt         DateTime?
  address                 address[]
  columnValueSelectOption columnValueSelectOption[]
  column_values           column_values[]
  user                    user                      @relation(fields: [createdBy], references: [id])
  workspace               workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dealMetaData            dealMetaData[]
  email                   email[]
  groupCompany            groupCompany[]
  interaction             interaction[]
  metaData                metaData[]
  phoneNumber             phoneNumber[]
  reminder                reminder[]
  url                     url[]
  userIntraction          userIntraction[]

  @@index([createdBy])
  @@index([description])
  @@index([name])
  @@index([name, workspaceId])
  @@index([privacyLevel, workspaceId])
  @@index([updatedAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, privacyLevel, createdBy])
}

model conversation {
  id                  String                @id @db.Uuid
  workspaceId         String                @db.Uuid
  userId              String                @db.Uuid
  title               String?
  context             Json?
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime              @db.Timestamp(6)
  aiInteraction       aiInteraction[]
  user                user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationMessage conversationMessage[]

  @@index([createdAt])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model conversationMessage {
  id             String           @id @db.Uuid
  conversationId String           @db.Uuid
  content        String
  metadata       Json?
  functionCalls  Json? //
  timestamp      DateTime         @default(now()) @db.Timestamp(6)
  role           ConversationRole
  conversation   conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, timestamp])
  @@index([role])
}

model deal {
  id                      String                    @id @db.Uuid
  name                    String
  columnId                String                    @db.Uuid
  createdAt               DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                  @db.Timestamp(6)
  createdBy               String?                   @db.Uuid
  columnValueSelectOption columnValueSelectOption[]
  column_values           column_values[]
  column                  column                    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user                    user?                     @relation(fields: [createdBy], references: [id])
  dealMetaData            dealMetaData[]
  reminder                reminder[]

  @@index([columnId, createdAt(sort: Desc)])
  @@index([columnId, name])
  @@index([name])
}

model dealMetaData {
  id        String   @id @db.Uuid
  dealId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @db.Timestamp(6)
  peopleId  String?  @db.Uuid
  companyId String?  @db.Uuid
  company   company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  people    people?  @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@unique([companyId, dealId])
  @@unique([peopleId, dealId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([dealId, companyId])
  @@index([dealId, peopleId])
  @@index([peopleId, createdAt(sort: Desc)])
}

model defaultColumn {
  id                        String                      @id @db.Uuid
  name                      String
  label                     String
  description               String?
  dataType                  ColumnDataType
  isRequired                Boolean                     @default(false)
  type                      ColumnType
  order                     Int
  isVisible                 Boolean                     @default(true)
  width                     Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  columnViewSettings        columnViewSettings[]
  profileColumnViewSettings profileColumnViewSettings[]

  @@index([dataType, type])
  @@index([isVisible, order])
  @@index([type, order])
}

model dismissedDuplicatePair {
  id                                              String    @id @db.Uuid
  workspaceId                                     String    @db.Uuid
  personId1                                       String    @db.Uuid
  personId2                                       String    @db.Uuid
  dismissedBy                                     String    @db.Uuid
  dismissedAt                                     DateTime  @default(now()) @db.Timestamp(6)
  user                                            user      @relation(fields: [dismissedBy], references: [id], onDelete: Cascade)
  people_dismissedDuplicatePair_personId1Topeople people    @relation("dismissedDuplicatePair_personId1Topeople", fields: [personId1], references: [id], onDelete: Cascade)
  people_dismissedDuplicatePair_personId2Topeople people    @relation("dismissedDuplicatePair_personId2Topeople", fields: [personId2], references: [id], onDelete: Cascade)
  workspace                                       workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, personId1, personId2])
  @@index([personId1])
  @@index([personId2])
  @@index([workspaceId, dismissedAt(sort: Desc)])
  @@index([workspaceId])
}

model domainVerificationLog {
  id        String   @id @db.Uuid
  senderId  String   @db.Uuid
  status    String
  message   String?
  checkedAt DateTime @default(now()) @db.Timestamp(6)
  details   Json?
  sender    sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, checkedAt(sort: Desc)])
  @@index([senderId])
  @@index([status, checkedAt(sort: Desc)])
}

model email {
  id        String     @id @db.Uuid
  value     String     @db.VarChar(255)
  type      EmailType?
  isPrimary Boolean    @default(false)
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime   @db.Timestamp(6)
  personId  String?    @db.Uuid
  companyId String?    @db.Uuid
  company   company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people    people?    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, value])
  @@index([companyId, isPrimary])
  @@index([isPrimary])
  @@index([personId, isPrimary])
  @@index([type])
  @@index([value])
  @@index([verified])
}

model emailIntegration {
  id                          String             @id @db.Uuid
  provider                    String
  isActive                    Boolean            @default(true)
  privacyLevel                InteractionPrivacy @default(PRIVATE)
  lastSyncAt                  DateTime?
  syncHistoryId               String?
  email                       String?
  workspaceId                 String             @db.Uuid
  userId                      String             @db.Uuid
  refreshToken                String
  refreshTokenExpiry          DateTime?
  connectionIssues            String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @default(now())
  gmailWatchExpiry            DateTime?
  microsoftClientState        String?
  microsoftSubscriptionExpiry DateTime?
  microsoftSubscriptionId     String?
  user                        user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace                   workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, userId])
  @@index([gmailWatchExpiry])
  @@index([lastSyncAt])
  @@index([microsoftSubscriptionExpiry])
  @@index([provider, isActive])
  @@index([userId, isActive])
  @@index([workspaceId, isActive])
}

model group {
  id                        String                      @id @db.Uuid
  name                      String
  workspaceId               String                      @db.Uuid
  description               String?
  emoji                     String?
  isPrivate                 Boolean                     @default(true)
  type                      GroupType                   @default(PEOPLE)
  isFavourite               Boolean                     @default(false)
  isDeleted                 Boolean                     @default(false)
  isCollapse                Boolean                     @default(true)
  createdBy                 String                      @db.Uuid
  createdAt                 DateTime                    @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime                    @default(now()) @db.Timestamp(6)
  favouriteOrder            Int                         @default(0)
  privateOrder              Int                         @default(0)
  publicOrder               Int                         @default(0)
  column                    column[]
  user                      user                        @relation(fields: [createdBy], references: [id])
  workspace                 workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groupCompany              groupCompany[]
  groupPeople               groupPeople[]
  importJob                 importJob[]
  profileColumnViewSettings profileColumnViewSettings[]
  view                      view[]

  @@index([createdBy, createdAt(sort: Desc)])
  @@index([name])
  @@index([workspaceId, createdBy])
  @@index([workspaceId])
  @@index([workspaceId, isFavourite, isDeleted])
  @@index([workspaceId, isPrivate])
  @@index([workspaceId, isPrivate, type])
  @@index([workspaceId, name])
  @@index([workspaceId, type, isDeleted])
}

model groupCompany {
  groupId   String   @db.Uuid
  companyId String   @db.Uuid
  addedAt   DateTime @default(now()) @db.Timestamp(6)
  addedBy   String   @db.Uuid
  user      user     @relation(fields: [addedBy], references: [id], onDelete: NoAction)
  company   company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group     group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, companyId])
  @@index([addedBy, addedAt(sort: Desc)])
  @@index([addedBy])
  @@index([companyId, addedAt(sort: Desc)])
  @@index([companyId, groupId])
  @@index([companyId])
  @@index([groupId, addedAt(sort: Desc)])
}

model groupPeople {
  groupId  String   @db.Uuid
  peopleId String   @db.Uuid
  addedAt  DateTime @default(now()) @db.Timestamp(6)
  addedBy  String   @db.Uuid
  user     user     @relation(fields: [addedBy], references: [id], onDelete: NoAction)
  group    group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  people   people   @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@id([groupId, peopleId])
  @@index([addedBy, addedAt(sort: Desc)])
  @@index([addedBy])
  @@index([groupId, addedAt(sort: Desc)])
  @@index([peopleId, addedAt(sort: Desc)])
  @@index([peopleId, groupId])
  @@index([peopleId])
}

model importJob {
  id              String    @id
  workspaceId     String    @db.Uuid
  userId          String    @db.Uuid
  groupId         String    @db.Uuid
  fileKey         String
  originalName    String
  mapping         Json
  module          String
  status          String
  totalQueues     Int       @default(0)
  processedQueues Int       @default(0)
  errorCount      Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @db.Timestamp(6)
  group           group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            user      @relation(fields: [userId], references: [id])
  workspace       workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([module, status])
  @@index([userId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model interaction {
  id           String          @id @db.Uuid
  type         InteractionType
  direction    Direction
  subject      String?
  content      String?
  date         DateTime
  createdAt    DateTime        @default(now()) @db.Timestamp(6)
  updatedAt    DateTime        @default(now()) @db.Timestamp(6)
  externalId   String?
  externalType String?
  metadata     Json?
  isDeleted    Boolean         @default(false)
  createdById  String          @db.Uuid
  peopleId     String?         @db.Uuid
  companyId    String?         @db.Uuid
  workspaceId  String          @db.Uuid
  company      company?        @relation(fields: [companyId], references: [id])
  user         user            @relation(fields: [createdById], references: [id])
  people       people?         @relation(fields: [peopleId], references: [id])
  workspace    workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([companyId, date(sort: Desc), isDeleted])
  @@index([companyId])
  @@index([content])
  @@index([createdById, date])
  @@index([externalId, externalType])
  @@index([externalId])
  @@index([peopleId, date(sort: Desc), isDeleted])
  @@index([peopleId])
  @@index([subject])
  @@index([workspaceId, date])
  @@index([workspaceId, direction, date])
  @@index([workspaceId, type, date])
  @@index([workspaceId, type, direction, date(sort: Desc)])
}

model metaData {
  id               String   @id @db.Uuid
  isPeoplePrimary  Boolean  @default(false)
  isCompanyPrimary Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  updatedAt        DateTime @db.Timestamp(6)
  peopleId         String   @db.Uuid
  companyId        String   @db.Uuid
  company          company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people           people   @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@unique([peopleId, companyId])
  @@index([companyId])
  @@index([companyId, isPeoplePrimary])
  @@index([peopleId, companyId, isCompanyPrimary])
  @@index([peopleId])
  @@index([peopleId, isCompanyPrimary])
}

model people {
  id                                                              String                    @id @db.Uuid
  firstName                                                       String                    @db.VarChar(100)
  lastName                                                        String?                   @db.VarChar(100)
  jobTitle                                                        String?                   @db.VarChar(1000)
  description                                                     String?
  dateOfBirth                                                     DateTime?                 @db.Date
  gender                                                          String?
  imageUrl                                                        String?
  privacyLevel                                                    PrivacyLevel?             @default(PRIVATE)
  createdAt                                                       DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                                                       DateTime                  @db.Timestamp(6)
  workspaceId                                                     String                    @db.Uuid
  createdBy                                                       String                    @db.Uuid
  avatarKey                                                       String?
  avatarContentType                                               String?
  avatarSize                                                      Int?
  avatarEtag                                                      String?
  avatarUpdatedAt                                                 DateTime?
  address                                                         address[]
  columnValueSelectOption                                         columnValueSelectOption[]
  column_values                                                   column_values[]
  dealMetaData                                                    dealMetaData[]
  dismissedDuplicatePair_dismissedDuplicatePair_personId1Topeople dismissedDuplicatePair[]  @relation("dismissedDuplicatePair_personId1Topeople")
  dismissedDuplicatePair_dismissedDuplicatePair_personId2Topeople dismissedDuplicatePair[]  @relation("dismissedDuplicatePair_personId2Topeople")
  email                                                           email[]
  groupPeople                                                     groupPeople[]
  interaction                                                     interaction[]
  metaData                                                        metaData[]
  user                                                            user                      @relation(fields: [createdBy], references: [id])
  workspace                                                       workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber                                                     phoneNumber[]
  reminder                                                        reminder[]
  url                                                             url[]
  userIntraction                                                  userIntraction[]

  @@index([createdBy])
  @@index([dateOfBirth])
  @@index([firstName, lastName])
  @@index([jobTitle])
  @@index([privacyLevel, workspaceId])
  @@index([updatedAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, firstName, lastName])
  @@index([workspaceId])
  @@index([workspaceId, privacyLevel, createdBy])
}

model phoneNumber {
  id        String           @id @db.Uuid
  value     String           @db.VarChar(50)
  type      PhoneNumberType?
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamp(6)
  updatedAt DateTime         @db.Timestamp(6)
  personId  String?          @db.Uuid
  companyId String?          @db.Uuid
  company   company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people    people?          @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([companyId, isPrimary])
  @@index([personId, isPrimary])
  @@index([type])
  @@index([value])
}

model profileColumnViewSettings {
  id              String         @id @db.Uuid
  order           Int
  isVisible       Boolean        @default(true)
  columnId        String?        @db.Uuid
  groupId         String         @db.Uuid
  defaultColumnId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  column          column?        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  defaultColumn   defaultColumn? @relation(fields: [defaultColumnId], references: [id], onDelete: Cascade)
  group           group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, columnId])
  @@unique([groupId, defaultColumnId])
  @@index([groupId, order, isVisible])
}

model reminder {
  id                 String             @id @db.Uuid
  title              String
  duedate            DateTime
  timezone           String
  recurring          String
  reminderVisibility ReminderVisibility
  createdBy          String             @db.Uuid
  workspaceId        String             @db.Uuid
  peopleId           String?            @db.Uuid
  companyId          String?            @db.Uuid
  dealId             String?            @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamp(6)
  updatedAt          DateTime           @db.Timestamp(6)
  company            company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               user               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  deal               deal?              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  people             people?            @relation(fields: [peopleId], references: [id], onDelete: Cascade)
  workspace          workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userReminder       userReminder[]

  @@index([workspaceId, companyId])
  @@index([workspaceId, dealId])
  @@index([workspaceId])
  @@index([workspaceId, peopleId])
}

model selectOption {
  id                      String                    @id @db.Uuid
  value                   String
  color                   String
  order                   Int
  pipelineOrder           Int?
  createdAt               DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                  @db.Timestamp(6)
  columnId                String                    @db.Uuid
  columnValueSelectOption columnValueSelectOption[]
  column                  column                    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  selectOptionSetting     selectOptionSetting[]

  @@index([columnId])
  @@index([columnId, order])
  @@index([columnId, pipelineOrder])
  @@index([value])
}

model selectOptionSetting {
  id             String       @id @db.Uuid
  selectOptionId String       @db.Uuid
  viewId         String       @db.Uuid
  isVisible      Boolean      @default(true)
  pipelineOrder  Int          @default(100)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @db.Timestamp(6)
  columnId       String       @db.Uuid
  column         column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  selectOption   selectOption @relation(fields: [selectOptionId], references: [id], onDelete: Cascade)
  view           view         @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([columnId, selectOptionId, viewId])
  @@index([columnId, selectOptionId, viewId])
}

model sender {
  id                         String                  @id @db.Uuid
  email                      String
  name                       String
  workspaceId                String                  @db.Uuid
  provider                   String
  refreshToken               String?
  accessIssue                String?
  createdAt                  DateTime                @default(now()) @db.Timestamp(6)
  updatedAt                  DateTime                @db.Timestamp(6)
  userId                     String                  @db.Uuid
  domain                     String?
  isSendgridDomain           Boolean                 @default(false)
  sendgridId                 String?
  dkimVerified               Boolean                 @default(false)
  spfVerified                Boolean                 @default(false)
  status                     String?
  verificationMethod         String?
  verificationToken          String?
  verificationExpiresAt      DateTime?
  lastCheckedAt              DateTime?
  verificationError          String?
  emailVerified              Boolean                 @default(false)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  domainVerificationLog      domainVerificationLog[]
  sendgridCnameRecord        sendgridCnameRecord[]

  @@index([domain, status])
  @@index([emailVerified, workspaceId])
  @@index([email])
  @@index([status, lastCheckedAt])
  @@index([userId, provider])
  @@index([workspaceId, provider])
}

model sendgridCnameRecord {
  id         String    @id @db.Uuid
  senderId   String    @db.Uuid
  type       String
  host       String
  subdomain  String?
  value      String
  ttl        Int?
  status     String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @db.Timestamp(6)
  sender     sender    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([host, type])
  @@index([senderId])
  @@index([senderId, type])
  @@index([status, verifiedAt])
}

model session {
  id          String     @id @db.Uuid
  deviceId    String     @unique
  userId      String     @db.Uuid
  workspaceId String?    @db.Uuid
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now()) @db.Timestamp(6)
  updatedAt   DateTime   @db.Timestamp(6)
  user        user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([userId])
  @@index([userId, workspaceId])
}

model url {
  id        String   @id @db.Uuid
  label     String?  @db.VarChar(100)
  value     String   @db.VarChar(500)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @db.Timestamp(6)
  personId  String?  @db.Uuid
  companyId String?  @db.Uuid
  company   company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people    people?  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([companyId, isPrimary])
  @@index([label])
  @@index([personId, isPrimary])
  @@index([value])
}

model user {
  id                                      String                   @id @db.Uuid
  email                                   String                   @unique
  firstName                               String
  lastName                                String?
  cognitoSub                              String                   @unique
  metaData                                Json?                    @db.Json
  createdAt                               DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt                               DateTime                 @db.Timestamp(6)
  avatarKey                               String?
  avatarContentType                       String?
  avatarSize                              Int?
  avatarEtag                              String?
  avatarUpdatedAt                         DateTime?
  aiAnalytics                             aiAnalytics[]
  aiInteraction                           aiInteraction[]
  company                                 company[]
  conversation                            conversation[]
  deal                                    deal[]
  dismissedDuplicatePair                  dismissedDuplicatePair[]
  emailIntegration                        emailIntegration[]
  group                                   group[]
  groupCompany                            groupCompany[]
  groupPeople                             groupPeople[]
  importJob                               importJob[]
  interaction                             interaction[]
  people                                  people[]
  reminder                                reminder[]
  session                                 session[]
  userIntraction                          userIntraction[]
  userInvitation                          userInvitation[]
  userReminder_userReminder_addedByTouser userReminder[]           @relation("userReminder_addedByTouser")
  userReminder_userReminder_userIdTouser  userReminder[]           @relation("userReminder_userIdTouser")
  workspaceMember                         workspaceMember[]

  @@index([createdAt])
  @@index([firstName, lastName])
  @@index([updatedAt])
}

model userIntraction {
  id        String   @id @db.Uuid
  peopleId  String?  @db.Uuid
  companyId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  createdBy String   @db.Uuid
  company   company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [createdBy], references: [id], onDelete: NoAction)
  people    people?  @relation(fields: [peopleId], references: [id], onDelete: Cascade, map: "userIntraction_latestPeopleId_fkey")

  @@index([companyId])
  @@index([createdBy, companyId])
  @@index([createdBy])
  @@index([createdBy, peopleId])
  @@index([peopleId])
}

model userInvitation {
  id              String    @id @db.Uuid
  email           String
  inviteCode      String    @unique
  workspaceId     String    @db.Uuid
  invitedByUserId String    @db.Uuid
  expiresAt       DateTime  @db.Timestamp(6)
  acceptedAt      DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @db.Timestamp(6)
  user            user      @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
  workspace       workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
  @@index([acceptedAt])
  @@index([email])
  @@index([expiresAt])
  @@index([workspaceId])
}

model userReminder {
  id                              String   @id @db.Uuid
  userId                          String   @db.Uuid
  reminderId                      String   @db.Uuid
  addedAt                         DateTime @default(now()) @db.Timestamp(6)
  addedBy                         String   @db.Uuid
  user_userReminder_addedByTouser user     @relation("userReminder_addedByTouser", fields: [addedBy], references: [id], onDelete: NoAction)
  reminder                        reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user_userReminder_userIdTouser  user     @relation("userReminder_userIdTouser", fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId, reminderId])
}

model view {
  id                  String                @id @db.Uuid
  name                String
  type                ViewType
  isDefault           Boolean               @default(false)
  groupId             String                @db.Uuid
  workspaceId         String                @db.Uuid
  targetEntity        TargetEntity
  groupBy             String?
  dealColumnId        String?               @db.Uuid
  isDeleted           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  condition           String?
  columnViewSettings  columnViewSettings[]
  selectOptionSetting selectOptionSetting[]
  column              column?               @relation(fields: [dealColumnId], references: [id], onDelete: Cascade)
  group               group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workspace           workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([groupId, isDeleted])
  @@index([type, targetEntity])
  @@index([workspaceId, isDefault, isDeleted])
  @@index([workspaceId, targetEntity, isDeleted])
}

model workspace {
  id                     String                   @id @db.Uuid
  name                   String
  createdAt              DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                 @db.Timestamp(6)
  avatarKey              String?
  avatarContentType      String?
  avatarSize             Int?
  avatarEtag             String?
  avatarUpdatedAt        DateTime?
  aiAnalytics            aiAnalytics[]
  aiCache                aiCache[]
  aiInteraction          aiInteraction[]
  company                company[]
  conversation           conversation[]
  dismissedDuplicatePair dismissedDuplicatePair[]
  emailIntegration       emailIntegration[]
  group                  group[]
  importJob              importJob[]
  interaction            interaction[]
  people                 people[]
  reminder               reminder[]
  session                session[]
  userInvitation         userInvitation[]
  view                   view[]
  workspaceMember        workspaceMember[]

  @@index([createdAt])
  @@index([name])
}

model workspaceMember {
  id          String    @id @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @db.Timestamp(6)
  role        Role      @default(MEMBER)
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "workspaceMember_user_fkey")
  workspace   workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workspaceMember_workspace_fkey")

  @@unique([userId, workspaceId])
  @@index([userId, role])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, role])
}

