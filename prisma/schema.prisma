generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EnrichmentRequest {
  id                String             @id @db.Uuid
  workspaceId       String             @db.Uuid
  groupId           String?            @db.Uuid
  requestedBy       String             @db.Uuid
  status            EnrichmentStatus   @default(PENDING)
  provider          String             @default("fullenrich")
  externalRequestId String?            @db.VarChar(255)
  totalItems        Int
  processedItems    Int                @default(0)
  failedItems       Int                @default(0)
  metadata          Json?
  startedAt         DateTime?          @db.Timestamp(6)
  completedAt       DateTime?          @db.Timestamp(6)
  createdAt         DateTime           @default(now()) @db.Timestamp(6)
  updatedAt         DateTime           @default(now()) @db.Timestamp(6)
  EnrichmentResult  EnrichmentResult[]

  @@index([createdAt])
  @@index([requestedBy])
  @@index([status])
  @@index([workspaceId])
}

model EnrichmentResult {
  id                String            @id @db.Uuid
  requestId         String            @db.Uuid
  personId          String?           @db.Uuid
  externalId        String?
  status            EnrichmentStatus  @default(PENDING)
  inputData         Json
  outputData        Json?
  error             String?
  retryCount        Int               @default(0)
  metadata          Json?
  startedAt         DateTime?         @db.Timestamp(6)
  completedAt       DateTime?         @db.Timestamp(6)
  createdAt         DateTime          @default(now()) @db.Timestamp(6)
  updatedAt         DateTime          @default(now()) @db.Timestamp(6)
  people            people?           @relation(fields: [personId], references: [id])
  EnrichmentRequest EnrichmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([externalId])
  @@index([personId])
  @@index([requestId])
  @@index([status])
}

model address {
  id        String       @id @db.Uuid
  value     String?      @db.VarChar(500)
  type      AddressType?
  createdAt DateTime     @default(now()) @db.Timestamp(6)
  updatedAt DateTime     @db.Timestamp(6)
  isPrimary Boolean      @default(false)
  personId  String?      @db.Uuid
  companyId String?      @db.Uuid
  company   company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people    people?      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([companyId, isPrimary])
  @@index([personId, isPrimary])
  @@index([type])
  @@index([value])
}

model column {
  id                        String                      @id @db.Uuid
  groupId                   String                      @db.Uuid
  name                      String
  description               String?
  dataType                  ColumnDataType
  isDefault                 Boolean                     @default(false)
  type                      ColumnType
  isDeleted                 Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  selectOptions             Json?                       @db.Json
  dealId                    String?                     @db.Uuid
  group                     group                       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  columnValueMember         columnValueMember[]
  columnValueSelectOption   columnValueSelectOption[]
  columnViewSettings        columnViewSettings[]
  column_values             column_values[]
  deal                      deal[]
  profileColumnViewSettings profileColumnViewSettings[]
  selectOption              selectOption[]
  selectOptionSetting       selectOptionSetting[]
  view                      view[]

  @@unique([groupId, name, type, isDeleted, dealId])
  @@index([dataType, type])
  @@index([groupId, isDefault, isDeleted])
  @@index([groupId, type, isDeleted])
  @@index([name])
}

model columnValueMember {
  id                                     String   @id @db.Uuid
  memberId                               String   @db.Uuid
  createdAt                              DateTime @default(now())
  columnId                               String   @db.Uuid
  companyId                              String?  @db.Uuid
  peopleId                               String?  @db.Uuid
  dealId                                 String?  @db.Uuid
  createdBy                              String   @db.Uuid
  column                                 column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  company                                company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user_columnValueMember_createdByTouser user     @relation("columnValueMember_createdByTouser", fields: [createdBy], references: [id])
  deal                                   deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user_columnValueMember_memberIdTouser  user     @relation("columnValueMember_memberIdTouser", fields: [memberId], references: [id], onDelete: Cascade)
  people                                 people?  @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@unique([columnId, memberId, companyId])
  @@unique([columnId, memberId, dealId])
  @@unique([columnId, memberId, peopleId])
  @@index([columnId])
  @@index([columnId, memberId, companyId])
  @@index([columnId, memberId])
  @@index([columnId, memberId, peopleId])
  @@index([companyId, columnId])
  @@index([companyId])
  @@index([dealId])
  @@index([memberId, companyId])
  @@index([memberId])
  @@index([memberId, peopleId])
  @@index([peopleId, columnId])
  @@index([peopleId])
}

model columnValueSelectOption {
  id             String       @id @db.Uuid
  selectOptionId String       @db.Uuid
  createdAt      DateTime     @default(now())
  columnId       String       @db.Uuid
  companyId      String?      @db.Uuid
  peopleId       String?      @db.Uuid
  dealId         String?      @db.Uuid
  column         column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  company        company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  people         people?      @relation(fields: [peopleId], references: [id], onDelete: Cascade)
  selectOption   selectOption @relation(fields: [selectOptionId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@index([columnId, selectOptionId, companyId])
  @@index([columnId, selectOptionId])
  @@index([columnId, selectOptionId, peopleId])
  @@index([companyId, columnId])
  @@index([companyId])
  @@index([dealId])
  @@index([peopleId, columnId])
  @@index([peopleId])
  @@index([selectOptionId, companyId])
  @@index([selectOptionId, peopleId])
}

model columnViewSettings {
  id              String         @id @db.Uuid
  order           Int
  isVisible       Boolean        @default(true)
  width           Int?
  columnId        String?        @db.Uuid
  viewId          String         @db.Uuid
  defaultColumnId String?        @db.Uuid
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  column          column?        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  defaultColumn   defaultColumn? @relation(fields: [defaultColumnId], references: [id], onDelete: Cascade)
  view            view           @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@unique([viewId, columnId])
  @@unique([viewId, defaultColumnId])
  @@index([viewId, isDeleted])
  @@index([viewId, order, isVisible])
}

model column_values {
  id              String   @id
  value           String
  createdAt       DateTime @default(now())
  columnId        String   @db.Uuid
  selectedOptions Json?    @db.Json
  companyId       String?  @db.Uuid
  peopleId        String?  @db.Uuid
  dealId          String?  @db.Uuid
  column          column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  company         company? @relation(fields: [companyId], references: [id])
  deal            deal?    @relation(fields: [dealId], references: [id])
  people          people?  @relation(fields: [peopleId], references: [id])

  @@index([columnId, createdAt(sort: Desc)])
  @@index([columnId])
  @@index([columnId, value])
  @@index([companyId, columnId])
  @@index([companyId, columnId, value])
  @@index([companyId])
  @@index([dealId, columnId, value])
  @@index([dealId])
  @@index([peopleId, columnId])
  @@index([peopleId, columnId, value])
  @@index([peopleId])
  @@index([value])
}

model company {
  id                      String                    @id @db.Uuid
  name                    String                    @db.VarChar(100)
  description             String?
  imageUrl                String?
  createdAt               DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                  @db.Timestamp(6)
  privacyLevel            PrivacyLevel?             @default(PRIVATE)
  workspaceId             String                    @db.Uuid
  createdBy               String                    @db.Uuid
  avatarKey               String?
  avatarContentType       String?
  avatarSize              Int?
  avatarEtag              String?
  avatarUpdatedAt         DateTime?
  address                 address[]
  columnValueMember       columnValueMember[]
  columnValueSelectOption columnValueSelectOption[]
  column_values           column_values[]
  user                    user                      @relation(fields: [createdBy], references: [id])
  workspace               workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dealMetaData            dealMetaData[]
  email                   email[]
  groupCompany            groupCompany[]
  interaction             interaction[]
  metaData                metaData[]
  phoneNumber             phoneNumber[]
  reminder                reminder[]
  url                     url[]
  userIntraction          userIntraction[]

  @@index([createdBy])
  @@index([description])
  @@index([name])
  @@index([name, workspaceId])
  @@index([privacyLevel, workspaceId])
  @@index([updatedAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, privacyLevel, createdBy])
}

model conversation {
  id                  String                @id @db.Uuid
  workspaceId         String                @db.Uuid
  userId              String                @db.Uuid
  title               String?
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime              @db.Timestamp(6)
  user                user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationMessage conversationMessage[]

  @@index([createdAt])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model conversationMessage {
  id             String           @id @db.Uuid
  conversationId String           @db.Uuid
  timestamp      DateTime         @default(now()) @db.Timestamp(6)
  role           ConversationRole
  conversation   conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageBlock   messageBlock[]

  @@index([conversationId])
  @@index([conversationId, timestamp])
  @@index([role])
}

model deal {
  id                      String                    @id @db.Uuid
  name                    String
  columnId                String                    @db.Uuid
  createdAt               DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt               DateTime                  @db.Timestamp(6)
  createdBy               String?                   @db.Uuid
  columnValueMember       columnValueMember[]
  columnValueSelectOption columnValueSelectOption[]
  column_values           column_values[]
  column                  column                    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user                    user?                     @relation(fields: [createdBy], references: [id])
  dealMetaData            dealMetaData[]
  reminder                reminder[]

  @@index([columnId, createdAt(sort: Desc)])
  @@index([columnId, name])
  @@index([name])
}

model dealMetaData {
  id        String   @id @db.Uuid
  dealId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @db.Timestamp(6)
  peopleId  String?  @db.Uuid
  companyId String?  @db.Uuid
  company   company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal      deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  people    people?  @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@unique([companyId, dealId])
  @@unique([peopleId, dealId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([dealId, companyId])
  @@index([dealId, peopleId])
  @@index([peopleId, createdAt(sort: Desc)])
}

model defaultColumn {
  id                        String                      @id @db.Uuid
  name                      String
  label                     String
  description               String?
  dataType                  ColumnDataType
  isRequired                Boolean                     @default(false)
  type                      ColumnType
  order                     Int
  isVisible                 Boolean                     @default(true)
  width                     Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  columnViewSettings        columnViewSettings[]
  profileColumnViewSettings profileColumnViewSettings[]

  @@index([dataType, type])
  @@index([isVisible, order])
  @@index([type, order])
}

model domainVerificationLog {
  id        String   @id @db.Uuid
  senderId  String   @db.Uuid
  status    String
  message   String?
  checkedAt DateTime @default(now()) @db.Timestamp(6)
  details   Json?
  sender    sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, checkedAt(sort: Desc)])
  @@index([senderId])
  @@index([status, checkedAt(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model duplicatePair {
  id                                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                            String          @db.Uuid
  personId1                              String          @db.Uuid
  personId2                              String          @db.Uuid
  detectionType                          DetectionType
  confidenceScore                        Int
  matchReasons                           String[]
  detectedAt                             DateTime        @default(now()) @db.Timestamp(6)
  detectedBy                             String?
  createdBy                              String          @db.Uuid
  status                                 DuplicateStatus @default(PENDING)
  actionedAt                             DateTime?       @db.Timestamp(6)
  actionedBy                             String?         @db.Uuid
  actionReason                           String?
  user_duplicatePair_actionedByTouser    user?           @relation("duplicatePair_actionedByTouser", fields: [actionedBy], references: [id])
  user_duplicatePair_createdByTouser     user            @relation("duplicatePair_createdByTouser", fields: [createdBy], references: [id], onDelete: Cascade)
  people_duplicatePair_personId1Topeople people          @relation("duplicatePair_personId1Topeople", fields: [personId1], references: [id], onDelete: Cascade)
  people_duplicatePair_personId2Topeople people          @relation("duplicatePair_personId2Topeople", fields: [personId2], references: [id], onDelete: Cascade)
  workspace                              workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, personId1, personId2], map: "unique_duplicate_pair")
  @@index([createdBy])
  @@index([detectedAt])
  @@index([personId1])
  @@index([personId2])
  @@index([workspaceId, createdBy, status])
  @@index([workspaceId, detectionType, status])
  @@index([workspaceId, status, confidenceScore(sort: Desc)])
  @@index([workspaceId, status, detectedAt(sort: Desc)])
  @@index([workspaceId, status])
}

model email {
  id        String     @id @db.Uuid
  value     String     @db.VarChar(255)
  type      EmailType?
  isPrimary Boolean    @default(false)
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime   @db.Timestamp(6)
  personId  String?    @db.Uuid
  companyId String?    @db.Uuid
  company   company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people    people?    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, value])
  @@index([companyId, isPrimary])
  @@index([isPrimary])
  @@index([personId, isPrimary])
  @@index([type])
  @@index([value])
  @@index([verified])
}

model emailIntegration {
  id                          String             @id @db.Uuid
  provider                    String
  isActive                    Boolean            @default(true)
  privacyLevel                InteractionPrivacy @default(PRIVATE)
  lastSyncAt                  DateTime?
  syncHistoryId               String?
  email                       String?
  workspaceId                 String             @db.Uuid
  userId                      String             @db.Uuid
  refreshToken                String
  refreshTokenExpiry          DateTime?
  connectionIssues            String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @default(now())
  gmailWatchExpiry            DateTime?
  microsoftClientState        String?
  microsoftSubscriptionExpiry DateTime?
  microsoftSubscriptionId     String?
  user                        user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace                   workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, userId])
  @@index([gmailWatchExpiry])
  @@index([lastSyncAt])
  @@index([microsoftSubscriptionExpiry])
  @@index([provider, isActive])
  @@index([userId, isActive])
  @@index([workspaceId, isActive])
}

model group {
  id                        String                      @id @db.Uuid
  name                      String
  workspaceId               String                      @db.Uuid
  description               String?
  emoji                     String?
  isPrivate                 Boolean                     @default(true)
  type                      GroupType                   @default(PEOPLE)
  isFavourite               Boolean                     @default(false)
  isDeleted                 Boolean                     @default(false)
  isCollapse                Boolean                     @default(true)
  createdBy                 String                      @db.Uuid
  createdAt                 DateTime                    @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime                    @default(now()) @db.Timestamp(6)
  favouriteOrder            Int                         @default(0)
  privateOrder              Int                         @default(0)
  publicOrder               Int                         @default(0)
  column                    column[]
  user                      user                        @relation(fields: [createdBy], references: [id])
  workspace                 workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groupCompany              groupCompany[]
  groupPeople               groupPeople[]
  importJob                 importJob[]
  profileColumnViewSettings profileColumnViewSettings[]
  view                      view[]

  @@index([createdBy, createdAt(sort: Desc)])
  @@index([name])
  @@index([workspaceId, createdBy])
  @@index([workspaceId])
  @@index([workspaceId, isFavourite, isDeleted])
  @@index([workspaceId, isPrivate])
  @@index([workspaceId, isPrivate, type])
  @@index([workspaceId, name])
  @@index([workspaceId, type, isDeleted])
}

model groupCompany {
  groupId   String   @db.Uuid
  companyId String   @db.Uuid
  addedAt   DateTime @default(now()) @db.Timestamp(6)
  addedBy   String   @db.Uuid
  user      user     @relation(fields: [addedBy], references: [id], onDelete: NoAction)
  company   company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group     group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, companyId])
  @@index([addedBy, addedAt(sort: Desc)])
  @@index([addedBy])
  @@index([companyId, addedAt(sort: Desc)])
  @@index([companyId, groupId])
  @@index([companyId])
  @@index([groupId, addedAt(sort: Desc)])
}

model groupPeople {
  groupId  String   @db.Uuid
  peopleId String   @db.Uuid
  addedAt  DateTime @default(now()) @db.Timestamp(6)
  addedBy  String   @db.Uuid
  user     user     @relation(fields: [addedBy], references: [id], onDelete: NoAction)
  group    group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  people   people   @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@id([groupId, peopleId])
  @@index([addedBy, addedAt(sort: Desc)])
  @@index([addedBy])
  @@index([groupId, addedAt(sort: Desc)])
  @@index([peopleId, addedAt(sort: Desc)])
  @@index([peopleId, groupId])
  @@index([peopleId])
}

model importJob {
  id              String    @id
  workspaceId     String    @db.Uuid
  userId          String    @db.Uuid
  groupId         String    @db.Uuid
  fileKey         String
  originalName    String
  mapping         Json
  module          String
  status          String
  totalQueues     Int       @default(0)
  processedQueues Int       @default(0)
  errorCount      Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @db.Timestamp(6)
  group           group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            user      @relation(fields: [userId], references: [id])
  workspace       workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([module, status])
  @@index([userId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model interaction {
  id           String          @id @db.Uuid
  type         InteractionType
  direction    Direction
  subject      String?
  content      String?
  date         DateTime
  createdAt    DateTime        @default(now()) @db.Timestamp(6)
  updatedAt    DateTime        @default(now()) @db.Timestamp(6)
  externalId   String?
  externalType String?
  metadata     Json?
  isDeleted    Boolean         @default(false)
  createdById  String          @db.Uuid
  peopleId     String?         @db.Uuid
  companyId    String?         @db.Uuid
  workspaceId  String          @db.Uuid
  company      company?        @relation(fields: [companyId], references: [id])
  user         user            @relation(fields: [createdById], references: [id])
  people       people?         @relation(fields: [peopleId], references: [id])
  workspace    workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([companyId, date(sort: Desc), isDeleted])
  @@index([companyId])
  @@index([content])
  @@index([createdById, date])
  @@index([externalId, externalType])
  @@index([externalId])
  @@index([peopleId, date(sort: Desc), isDeleted])
  @@index([peopleId])
  @@index([subject])
  @@index([workspaceId, date])
  @@index([workspaceId, direction, date])
  @@index([workspaceId, type, date])
  @@index([workspaceId, type, direction, date(sort: Desc)])
}

model messageBlock {
  id                  String              @id @db.Uuid
  messageId           String              @db.Uuid
  blockType           BlockType
  content             String
  metadata            Json?
  order               Int
  entityMentions      Json?
  createdAt           DateTime            @default(now()) @db.Timestamp(6)
  conversationMessage conversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, order])
}

model metaData {
  id               String   @id @db.Uuid
  isPeoplePrimary  Boolean  @default(false)
  isCompanyPrimary Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  updatedAt        DateTime @db.Timestamp(6)
  peopleId         String   @db.Uuid
  companyId        String   @db.Uuid
  company          company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  people           people   @relation(fields: [peopleId], references: [id], onDelete: Cascade)

  @@unique([peopleId, companyId])
  @@index([companyId])
  @@index([companyId, isPeoplePrimary])
  @@index([peopleId, companyId, isCompanyPrimary])
  @@index([peopleId])
  @@index([peopleId, isCompanyPrimary])
}

model people {
  id                                            String                    @id @db.Uuid
  firstName                                     String                    @db.VarChar(100)
  lastName                                      String?                   @db.VarChar(100)
  jobTitle                                      String?                   @db.VarChar(1000)
  description                                   String?
  dateOfBirth                                   DateTime?                 @db.Date
  gender                                        String?
  imageUrl                                      String?
  privacyLevel                                  PrivacyLevel?             @default(PRIVATE)
  createdAt                                     DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                                     DateTime                  @db.Timestamp(6)
  workspaceId                                   String                    @db.Uuid
  createdBy                                     String                    @db.Uuid
  avatarKey                                     String?
  avatarContentType                             String?
  avatarSize                                    Int?
  avatarEtag                                    String?
  avatarUpdatedAt                               DateTime?
  EnrichmentResult                              EnrichmentResult[]
  address                                       address[]
  columnValueMember                             columnValueMember[]
  columnValueSelectOption                       columnValueSelectOption[]
  column_values                                 column_values[]
  dealMetaData                                  dealMetaData[]
  duplicatePair_duplicatePair_personId1Topeople duplicatePair[]           @relation("duplicatePair_personId1Topeople")
  duplicatePair_duplicatePair_personId2Topeople duplicatePair[]           @relation("duplicatePair_personId2Topeople")
  email                                         email[]
  groupPeople                                   groupPeople[]
  interaction                                   interaction[]
  metaData                                      metaData[]
  user                                          user                      @relation(fields: [createdBy], references: [id])
  workspace                                     workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber                                   phoneNumber[]
  reminder                                      reminder[]
  url                                           url[]
  userIntraction                                userIntraction[]

  @@index([createdBy])
  @@index([dateOfBirth])
  @@index([firstName, lastName])
  @@index([jobTitle])
  @@index([privacyLevel, workspaceId])
  @@index([updatedAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, firstName, lastName])
  @@index([workspaceId])
