# ============================================
# Docker Build Ignore File
# Speeds up builds by excluding unnecessary files
# ============================================

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info
*.egg
.eggs
dist/
build/
*.whl

# Virtual environments
venv/
.venv/
ENV/
env/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json

# Linting
.ruff_cache/

# Documentation
docs/
*.md
!README.md

# Local environment files (secrets should be injected at runtime)
.env
.env.*
!.env.example

# Docker files (no need to include in context)
docker-compose*.yml
Dockerfile*
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Misc
*.log
*.tmp
.DS_Store
Thumbs.db
*.bak

# Tests (optional - uncomment if you don't need tests in the image)
# tests/

