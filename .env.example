# ============================================================================
# AI Analyst Pipeline - Environment Variables Configuration
# ============================================================================
# This file contains all environment variables used across the application.
# Copy this file to .env and fill in your actual values.
# ============================================================================


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database Connection URL
# Format: postgresql://username:password@host:port/database_name
# Used by Prisma ORM for database operations
# Required for application to function
DATABASE_URL=postgresql://user:password@localhost:5432/analyst_ai

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Redis server hostname or IP address
# Used for caching query results and improving performance
# Optional but recommended for production
REDIS_HOST=localhost

# Redis server port number
# Default Redis port is 6379
REDIS_PORT=6379

# Redis database number (0-15)
# Allows isolation of data within the same Redis instance
REDIS_DB=0


# ============================================================================
# LLM PROVIDER API KEYS
# ============================================================================
# API keys for Language Model providers
# At least one provider's API key is required
# Choose based on which LLM provider(s) you want to use
# ============================================================================

# OpenAI API Key
# Used for GPT models (gpt-4, gpt-3.5-turbo, etc.)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=REDACTED_OPENAI_API_KEY

# Anthropic API Key
# Used for Claude models (claude-3-opus, claude-3-sonnet, etc.)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=REDACTED_OPENAI_API_KEY

# Google API Key
# Used for Gemini models (gemini-pro, gemini-ultra, etc.)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here


# ============================================================================
# GLOBAL LLM CONFIGURATION (REQUIRED)
# ============================================================================
# These settings apply to all agents unless overridden by agent-specific config
# REQUIRED: At least GLOBAL_LLM_PROVIDER and GLOBAL_LLM_MODEL must be set
# ============================================================================

# Global LLM Provider
# Options: openai, anthropic, gemini
# This provider will be used by all agents unless overridden
# REQUIRED if not using database configuration or agent-specific overrides
GLOBAL_LLM_PROVIDER=openai

# Global LLM Model
# Depends on the provider chosen:
#   OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
#   Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
#   Gemini: gemini-pro, gemini-1.5-pro
# REQUIRED if not using database configuration or agent-specific overrides
GLOBAL_LLM_MODEL=gpt-4


CONTEXT_K_RECENT=10
CONTEXT_R_RETRIEVED=5



QDRANT_URL=http://qdrant:6333              # Already existed
QDRANT_API_KEY=your-api-key                # Optional (for Qdrant Cloud)
QDRANT_COLLECTION_NAME=conversation_messages
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_SIZE=384
QDRANT_SCORE_THRESHOLD=0.3


# ============================================================================
# AGENT-SPECIFIC LLM CONFIGURATION
# ============================================================================
# Override LLM settings for individual agents
# Useful when different agents need different models or providers
# If not set, agents will use GLOBAL_LLM_PROVIDER and GLOBAL_LLM_MODEL
# ============================================================================

# Query Optimizer Agent Configuration
# Handles natural language query parsing and optimization
# QUERY_OPTIMIZER_PROVIDER=openai
# QUERY_OPTIMIZER_MODEL=gpt-4
# QUERY_OPTIMIZER_API_KEY=sk-your-openai-key

# Data Extractor Agent Configuration
# Extracts and processes data from databases
# DATA_EXTRACTOR_PROVIDER=openai
# DATA_EXTRACTOR_MODEL=gpt-4
# DATA_EXTRACTOR_API_KEY=sk-your-openai-key

# Response Formatter Agent Configuration
# Formats the final response for users
# This agent typically uses a lighter/faster model
# RESPONSE_FORMATTER_PROVIDER=openai
# RESPONSE_FORMATTER_MODEL=gpt-3.5-turbo
# RESPONSE_FORMATTER_API_KEY=sk-your-openai-key


# ============================================================================
# AWS CONFIGURATION
# ============================================================================
# Required for using AWS services (DynamoDB, Cognito)
# ============================================================================

# AWS Region
# The AWS region where your resources are deployed
AWS_REGION=us-east-1

# AWS Access Key ID
# Your AWS IAM user access key
AWS_ACCESS_KEY_ID=your-access-key-id

# AWS Secret Access Key
# Your AWS IAM user secret key (keep this secure!)
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Cognito User Pool ID
# Required for JWT token authentication
# Format: us-east-1_xxxxxxxxx
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx


# ============================================================================
# APPLICATION CONFIGURATION (Optional)
# ============================================================================

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# API Server Port
# Port on which the FastAPI server will run
# Default: 8000
# PORT=8000

# API Server Host
# Host address for the FastAPI server
# Default: 0.0.0.0 (all interfaces)
# HOST=0.0.0.0


# ============================================================================
# NOTES
# ============================================================================
#
# Configuration Priority (highest to lowest):
# 1. Database agent-specific configuration (if set in database)
# 2. Database global configuration (if set in database)
# 3. Agent-specific environment variables (AGENT_PROVIDER, AGENT_MODEL, AGENT_API_KEY)
# 4. Global environment variables (GLOBAL_LLM_PROVIDER, GLOBAL_LLM_MODEL)
#
# IMPORTANT: Hardcoded defaults have been removed. You MUST provide configuration
# via database or environment variables. The application will raise an error if
# provider and model are not configured through one of the above methods.
#
# API Keys:
# - API keys are ALWAYS sourced from environment variables for security
# - Never commit actual API keys to version control
# - Use different keys for development, staging, and production
#
# Database:
# - Prisma automatically reads DATABASE_URL for database operations
# - Run 'prisma generate' after changing the database schema
# - Run 'prisma migrate dev' to apply database migrations
# - Use scripts/seed_llm_config.py to seed LLM configuration in database
#
# Redis:
# - Redis is optional but highly recommended for caching
# - Improves performance by caching query results
# - If Redis is unavailable, the application will still function
#
# Security:
# - Never share or expose your .env file
# - Use different credentials for each environment
# - Rotate API keys regularly
# - Review AWS IAM permissions to follow the principle of least privilege
#
# ============================================================================
