# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# GraphQL Backend Configuration
GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Redis Configuration (Session Storage)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Multi-Provider Support)
# Set API keys for the providers you want to use

# OpenAI (GPT-4, GPT-3.5, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# Model Routing (Mix and match models from different providers!)
# Examples:
# - PLANNER_MODEL=gpt-4-turbo-preview (OpenAI)
# - PLANNER_MODEL=claude-3-opus-20240229 (Anthropic)
# - PLANNER_MODEL=gemini-1.5-pro (Google)

PLANNER_MODEL=gpt-4-turbo-preview
SUMMARY_MODEL=gpt-3.5-turbo
REASONING_MODEL=claude-3-opus-20240229
FALLBACK_MODEL=gemini-pro

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Session Configuration
SESSION_TTL_SECONDS=604800  # 7 days

# Optional: Sentry Error Tracking
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Monitoring
# PROMETHEUS_ENABLED=true

# ============================================================================
# AI Analyst Pipeline - Environment Variables Configuration
# ============================================================================
# This file contains all environment variables used across the application.
# Copy this file to .env and fill in your actual values.
# ============================================================================


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database Connection URL
# Format: postgresql://username:password@host:port/database_name
# Used by Prisma ORM for database operations
# Required for application to function
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/softsync?schema=public

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Redis server hostname or IP address
# Used for caching query results and improving performance
# Optional but recommended for production
REDIS_HOST=localhost

# Redis server port number
# Default Redis port is 6379
REDIS_PORT=6379

# Redis database number (0-15)
# Allows isolation of data within the same Redis instance
REDIS_DB=0

OPENAI_API_KEY=REDACTED_OPENAI_API_KEY
ANTHROPIC_API_KEY=REDACTED_OPENAI_API_KEY
GOOGLE_API_KEY=AIzaSyAdlFuGdNRQ-7HZdW_s0KUt2Pm3nd7VmXE


GLOBAL_LLM_PROVIDER=openai

GLOBAL_LLM_MODEL=gpt-4


# AWS Region
# The AWS region where your resources are deployed
AWS_REGION=eu-north-1

# AWS Access Key ID
# Your AWS IAM user access key
AWS_ACCESS_KEY_ID=REDACTED_AWS_ACCESS_KEY_ID

# AWS Secret Access Key
# Your AWS IAM user secret key (keep this secure!)
AWS_SECRET_ACCESS_KEY=REDACTED_AWS_SECRET_ACCESS_KEY

# AWS Cognito User Pool ID
# Required for JWT token authentication
# Format: us-east-1_xxxxxxxxx
AWS_COGNITO_USER_POOL_ID=eu-north-1_JVkPZRDwj



AWS_COGNITO_USER_POOL_ID="eu-north-1_JVkPZRDwj"
AWS_COGNITO_CLIENT_ID="2ek791ejt6sh0u3koehp2g2h45"
AWS_COGNITO_CLIENT_SECRET="rgdmrpcoi3svvj9n74hhrfk6khsj1lnik8ejflel3kmgrnfgp2p"
AWS_COGNITO_DOMAIN="eu-north-1jvkpzrdwj.auth.eu-north-1.amazoncognito.com"
COGNITO_REDIRECT_URI="https://www.softsync.ai/oauth/callback"

# DynamoDB Table Name
# Table name for storing email interactions and synced emails
# Default: prod-softsync
DYNAMODB_TABLE=prod-softsync
