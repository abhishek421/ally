# Application Settings
APP_NAME="LangGraph Orchestration"
APP_VERSION="1.0.0"
LOG_LEVEL="INFO"

# API Keys (Uncomment and set the ones you intend to use)
OPENAI_API_KEY=REDACTED
GOOGLE_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# LLM Configuration
LLM_MODEL="gpt-4.1-nano"
SUMMARY_MODEL="gpt-4o-mini"
QUERY_PROCESSING_MODEL="gpt-4o"
LLM_CONTEXT_LIMIT=128000
LLM_MAX_TOKENS=4096
CONTEXT_THRESHOLD_PERCENTAGE=70

# Tokenizer Configuration
TOKENIZER_TYPE="tiktoken"

# Storage Configuration
STORAGE_TYPE="langgraph"

# Node Configuration
QUERY_BUILDER_TIMEOUT=30
QUERY_PROCESSING_TIMEOUT=60
MAX_REACT_ITERATIONS=10
ENABLE_TOOLS=True

# Graph Configuration
MAX_ITERATIONS=100

# Database Configuration
# DATABASE_URL_ALLY=postgresql+asyncpg://user:password@localhost:5432/dbname
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_ECHO=False

# Workspace Configuration
# WORKSPACE_ID=

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_RELOAD=False

