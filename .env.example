# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# GraphQL Backend Configuration
GRAPHQL_ENDPOINT=http://localhost:4400/graphql

# Redis Configuration (Session Storage)
REDIS_URL=redis://localhost:6379/0

DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/softsync?schema=public


# LLM Configuration (Multi-Provider Support)
# Set API keys for the providers you want to use

# OpenAI (GPT-4, GPT-3.5, etc.)
OPENAI_API_KEY=REDACTED_OPENAI_API_KEY
# Anthropic (Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini models)
GOOGLE_API_KEY=AIzaSyAdlFuGdNRQ-7HZdW_s0KUt2Pm3nd7VmXE

# Model Configuration
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# Model Routing (Mix and match models from different providers!)
# Examples:
# - PLANNER_MODEL=gpt-4-turbo-preview (OpenAI)
# - PLANNER_MODEL=claude-3-opus-20240229 (Anthropic)
# - PLANNER_MODEL=gemini-1.5-pro (Google)

PLANNER_MODEL=gpt-4.1
SUMMARY_MODEL=gpt-4.1-nano
REASONING_MODEL=gemini-2.5-pro
FALLBACK_MODEL=gemini-2.5-pro

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Session Configuration
SESSION_TTL_SECONDS=604800  # 7 days

# Optional: Sentry Error Tracking
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Monitoring
# PROMETHEUS_ENABLED=true

